# Marine Sentinel Backend Configuration Example
# Copy this file to '.env' in the backend directory and configure for your local hardware.

# Database URL
DATABASE_URL=sqlite:///./marine_sentinel.db

# Serial Port Configuration for Hardware Integration
# On Windows, use COM ports (e.g. COM3). On Linux/macOS, use device files (e.g. /dev/ttyUSB0).
# Leave empty to run in simulated fallback demo mode.
SERIAL_ARDUINO_PORT=
SERIAL_ESP32_PORT=

# Baud Rate Configuration
SERIAL_ARDUINO_BAUD=115200
SERIAL_ESP32_BAUD=115200

# Environmental Sensor Status Thresholds
TURBIDITY_WARNING_THRESHOLD=400
TURBIDITY_CRITICAL_THRESHOLD=600
PH_MIN_THRESHOLD=6.5
PH_MAX_THRESHOLD=8.5
